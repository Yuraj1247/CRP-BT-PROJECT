{
  "name": "cert-secure-backend",
  "version": "1.0.0",
  "description": "Secure Certificate Generation, Digital Signature, AES Storage, and QR Verification API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --config nodemon.json server.js",
    "dev:node": "node --watch --watch-path=./server.js --watch-path=./crypto --watch-path=./routes --watch-path=./services --watch-path=./config server.js",
    "test:crypto": "node test-crypto.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^12.7.0",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4"
  }
}
