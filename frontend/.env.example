# To use Firebase as the sole backend (No Node server needed!):
VITE_USE_FIREBASE_BACKEND=true

# Firebase Web App Config (From Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForSparkDev12345
VITE_FIREBASE_AUTH_DOMAIN=cert-secure-spark-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cert-secure-spark-demo
VITE_FIREBASE_STORAGE_BUCKET=cert-secure-spark-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Optional: Master AES secret key for client encryption
VITE_AES_SECRET_KEY=e4d9b28a7c1f03e659b8a1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2
